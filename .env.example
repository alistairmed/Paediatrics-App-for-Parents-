# Copy to .env.local for `npm run dev`; on Vercel set these in
# Project Settings -> Environment Variables. Only VITE_ variables reach the
# browser, so keys and secrets must never start with VITE_.

# --- AI on/off (both off by default) ---------------------------------------
# ENABLE_AI is read by the /api/ai endpoint, VITE_ENABLE_AI by the app.
ENABLE_AI=false
VITE_ENABLE_AI=false

# --- Free tier: Google Gemini 2.5 Flash ------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# --- Premium tier: Anthropic Claude (claude-sonnet-5-5) --------------------
# Premium stays off (503, and "Premium (coming soon)" in the app) unless both are true.
PREMIUM_ENABLED=false
VITE_PREMIUM_ENABLED=false
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Signs premium entitlement tokens. At least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ENTITLEMENT_SECRET=change_me_to_at_least_32_random_characters
