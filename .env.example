# Server-side Gemini API Key for Vercel Serverless API Proxy (/api/gemini)
# Set this in Vercel Project Settings -> Environment Variables
# Do NOT prefix with VITE_ to keep it secret from client browsers.
GEMINI_API_KEY=your_gemini_api_key_here

# AI features are off by default. Set both to true to turn them on:
# ENABLE_AI is read by the /api/gemini proxy, VITE_ENABLE_AI by the app.
ENABLE_AI=false
VITE_ENABLE_AI=false
