<?xml version="1.0" encoding="utf-8"?>
<!-- Health records stay on this phone: no cloud backup and no device-to-device copy.
     Parents move records with an encrypted backup file instead (Privacy, Backup & Lock). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
